# Address of the Laravel backend (runtimeConfig.public.apiBase).
# Leave it empty in development: the dev server then uses the host of the page with port 8000, so both
# http://localhost:3000 and http://<IP-des-Mac>:3000 (a tablet in the local network) work.
# A build (nuxt generate) takes the address from here, for example https://api.planer-test.example.com.
NUXT_PUBLIC_API_BASE=
