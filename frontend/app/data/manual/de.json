    "id": "tasks-ueber-mcp",
    "title": "Tasks über MCP ändern",
    "area": "agents",
    "scope": "app",
    "since": "1.6",
    "purpose": {
      "type": "doc",
      "content": [
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "Ein Agent liest und ändert Tasks über den MCP-Server, ohne den ganzen Plan zu laden. So bleibt jede Änderung klein, und der Stand im Planer stimmt mit der Arbeit überein.",
              "marks": []
            }
          ]
        }
      ]
    },
    "steps": [],
    "notes": {
      "type": "doc",
      "content": [
        {
          "type": "bulletList",
          "content": [
            {
              "type": "listItem",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "Der Agent handelt als sein eigenes Konto, mit genau dessen Rechten. Was er im Projekt nicht darf, verweigert der Server.",
                      "marks": []
                    }
                  ]
                }
              ]
            },
            {
              "type": "listItem",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "Status von ToDo und Milestone leitet der Planer aus den Tasks ab. Ein Agent setzt sie nie selbst.",
                      "marks": []
                    }
                  ]
                }
              ]
            },
            {
              "type": "listItem",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "Welche Status ein Agent setzen darf, bestimmt seine Rolle im Projekt. Eine Person im Projekt kann zusätzlich festlegen, wer einen Task als erledigt markiert.",
                      "marks": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    "prompts": [
      "Zeige mir mit list_tasks meine Tasks im Projekt [Projekt], die «In Arbeit» oder «Review» sind.",
      "Setze mit update_tasks den Task [k-123] auf «Review» und trage den Commit [Hash] ein. Schreibe danach mit add_comment einen kurzen Bericht an den Task.",
      "Lege im Milestone [Milestone] des Projekts [Projekt] einen Task «[Titel]» an: exportiere nur diesen Milestone, ergänze den Task und importiere mit mode: \"partial\", zuerst als Trockenlauf."
    ]
