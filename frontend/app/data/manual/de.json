    "notes": {
      "type": "doc",
      "content": [
        {
          "type": "bulletList",
          "content": [
            {
              "type": "listItem",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "Der Zugang ist ein Geheimnis. Er gehört in den Passwortmanager oder in eine Umgebungsvariable, nie in eine Datei im Repository oder in einen Chat.",
                      "marks": []
                    }
                  ]
                }
              ]
            },
            {
              "type": "listItem",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "Hast du den Zugang verloren, widerrufe ihn im selben Dialog und erzeuge einen neuen.",
                      "marks": []
                    }
                  ]
                }
              ]
            },
            {
              "type": "listItem",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "Ohne Projekt sieht der Agent nichts. Was er im Projekt darf, bestimmt seine Rolle dort.",
                      "marks": []
                    }
                  ]
                }
              ]
            },
            {
              "type": "listItem",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "Die Adresse des MCP-Servers und eine Anleitung für den Connector stehen im selben Dialog.",
                      "marks": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    "prompts": [
      "Verbinde dich mit dem MCP-Server des Mollo Planers über die Variable [VARIABLE] und zeige mir die Projekte, die du siehst.",
      "Prüfe mit list_projects, welche Rolle du im Projekt [Projekt] hast und was du dort ändern darfst."
    ]
