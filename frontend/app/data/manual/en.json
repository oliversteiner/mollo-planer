                    {
                      "type": "text",
                      "text": "New task",
                      "marks": [
                        {
                          "type": "bold"
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "text": " is missing or grey, create a todo first.",
                      "marks": []
