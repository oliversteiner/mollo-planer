    "notes": {
      "type": "doc",
      "content": [
        {
          "type": "bulletList",
          "content": [
            {
              "type": "listItem",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "The access is a secret. It belongs in a password manager or an environment variable, never in a file under version control or in a chat.",
                      "marks": []
                    }
                  ]
                }
              ]
            },
            {
              "type": "listItem",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "If you lost the access, revoke it in the same dialog and create a new one.",
                      "marks": []
                    }
                  ]
                }
              ]
            },
            {
              "type": "listItem",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "Without a project the agent sees nothing. What it may do in the project depends on its role there.",
                      "marks": []
                    }
                  ]
                }
              ]
            },
            {
              "type": "listItem",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "The address of the MCP server and a guide for the connector are in the same dialog.",
                      "marks": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    "prompts": [
      "Connect to the MCP server of Mollo Planer with the variable [VARIABLE] and show me the projects you see.",
      "Check with list_projects which role you have in the project [project] and what you may change there."
    ]
