      },
      {
        "doc": {
          "type": "doc",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Choose the button with the copy symbol to the right of the field with the access, and keep the access in your password manager at once. It is shown only once. Then choose ",
                  "marks": []
                },
                {
                  "type": "text",
                  "text": "Stored",
                  "marks": [
                    {
                      "type": "bold"
                    }
                  ]
                },
                {
                  "type": "text",
                  "text": ".",
                  "marks": []
                }
              ]
            }
