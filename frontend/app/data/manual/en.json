    "id": "tasks-ueber-mcp",
    "title": "Change tasks over MCP",
    "area": "agents",
    "scope": "app",
    "since": "1.6",
    "type": "chapter",
    "body": null,
    "purpose": {
      "type": "doc",
      "content": [
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "An agent reads and changes tasks through the MCP server without loading the whole plan. Each change stays small, and the state in the planer matches the work.",
              "marks": []
            }
          ]
        }
      ]
    },
    "steps": [],
    "notes": {
      "type": "doc",
      "content": [
        {
          "type": "bulletList",
          "content": [
            {
              "type": "listItem",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "The agent acts as its own account, with exactly its rights. What it may not do in the project, the server refuses.",
                      "marks": []
                    }
                  ]
                }
              ]
            },
            {
              "type": "listItem",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "The planer derives the status of todo and milestone from the tasks. An agent never sets them.",
                      "marks": []
                    }
                  ]
                }
              ]
            },
            {
              "type": "listItem",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "Which statuses an agent may set depends on its role in the project. A person in the project can also decide who marks a task as done.",
                      "marks": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    "prompts": [
      "With list_tasks, show me my tasks in the project [project] that are «In progress» or «Review».",
      "With update_tasks, set the task [k-123] to «Review» and enter the commit [hash]. Then write a short report on the task with add_comment.",
      "In the milestone [milestone] of the project [project], create a task «[title]»: export only this milestone, add the task and import with mode: \"partial\", as a dry run first."
    ]
  }
]
