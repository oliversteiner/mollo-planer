            }
          ]
        },
        "images": []
      },
      {
        "doc": {
          "type": "doc",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "In the field ",
                  "marks": []
                },
                {
                  "type": "text",
                  "text": "Name of the access",
                  "marks": [
                    {
                      "type": "bold"
                    }
                  ]
                },
                {
                  "type": "text",
                  "text": ", keep the suggested name or change it. Choose ",
                  "marks": []
