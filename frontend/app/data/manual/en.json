    "id": "agent-anlegen",
    "title": "Create an agent and set up its access",
    "area": "admin",
    "scope": "core",
    "since": "1.6",
    "type": "chapter",
    "body": null,
    "purpose": {
      "type": "doc",
      "content": [
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "An agent is an account of its own for Claude or an assistant. It does not sign in in the browser but works through the connector (MCP) with an access, and it may do exactly what its role in the project allows.",
              "marks": []
            }
          ]
        }
      ]
    },
    "steps": [
      {
        "doc": {
          "type": "doc",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Open ",
                  "marks": []
                },
                {
                  "type": "text",
                  "text": "Administration → Users",
                  "marks": [
                    {
                      "type": "bold"
                    }
                  ]
                },
                {
                  "type": "text",
                  "text": ".",
                  "marks": []
                }
              ]
            }
          ]
        },
        "images": []
      },
      {
        "doc": {
          "type": "doc",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Choose ",
                  "marks": []
                },
                {
                  "type": "text",
                  "text": "Create agent",
                  "marks": [
                    {
                      "type": "bold"
                    }
                  ]
                },
                {
                  "type": "text",
                  "text": " at the top right.",
                  "marks": []
                }
              ]
            }
          ]
        },
        "images": []
      },
      {
        "doc": {
          "type": "doc",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "In the field ",
                  "marks": []
                },
                {
                  "type": "text",
                  "text": "Name",
                  "marks": [
                    {
                      "type": "bold"
                    }
                  ]
                },
                {
                  "type": "text",
                  "text": ", enter a name. Mollo Planer makes the agent's identifier from it, for example ",
                  "marks": []
                },
                {
                  "type": "text",
                  "text": "claude-club-db@agent.invalid",
                  "marks": [
                    {
                      "type": "code"
                    }
                  ]
                },
                {
                  "type": "text",
                  "text": ". No mail is ever sent to an agent.",
                  "marks": []
                }
              ]
            }
          ]
        },
        "images": []
      },
      {
        "doc": {
          "type": "doc",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Choose ",
                  "marks": []
                },
                {
                  "type": "text",
                  "text": "Create",
                  "marks": [
                    {
                      "type": "bold"
                    }
                  ]
                },
                {
                  "type": "text",
                  "text": ". The dialog closes, and the row of the new agent is highlighted.",
                  "marks": []
                }
              ]
