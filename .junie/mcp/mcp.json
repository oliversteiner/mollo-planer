{
    "mcpServers": {
        "laravel-boost": {
            "command": "php",
            "args": [
                "backend/artisan",
                "boost:mcp"
            ]
        },
        "mollo-planer": {
            "url": "http://localhost:8000/mcp",
            "headers": {
                "Authorization": "Bearer ${MOLLOPLANER_TOKEN}"
            }
        }
    }
}