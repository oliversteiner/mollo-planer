{
    "mcpServers": {
        "laravel-boost": {
            "command": "php",
            "args": [
                "backend/artisan",
                "boost:mcp"
            ]
        },
        "mollo-planer": {
            "type": "http",
            "url": "${MOLLOPLANER_MCP_URL}",
            "headers": {
                "Authorization": "Bearer ${MOLLOPLANER_TOKEN}"
            }
        }
    }
}
