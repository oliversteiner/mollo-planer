[
    {
        "name": "add_comment",
        "description": "Adds a Markdown comment to a task.",
        "inputSchema": {
            "type": "object",
            "properties": {
                "task_id": {
                    "type": "string",
                    "description": "Id of the task, k-<id> or the number."
                },
                "text": {
                    "type": "string",
                    "description": "The comment in Markdown."
                }
            },
            "required": [
                "task_id",
                "text"
            ]
        },
        "annotations": {
            "title": "Tool Adapter"
        }
    },
    {
        "name": "create_idea",
        "description": "Saves a private idea (optionally with a project or a planer-v2 draft).",
        "inputSchema": {
            "type": "object",
            "properties": {
                "title": {
                    "type": "string",
                    "description": "Title, 2-200 characters."
                },
                "description": {
                    "type": "string",
                    "description": "Markdown."
                },
                "project_id": {
                    "type": "string",
                    "description": "Project ID, or leave out."
                },
                "draft": {
                    "type": "object",
                    "description": "planer-v2 excerpt, or leave out."
                }
            },
            "required": [
                "title"
            ]
        },
        "annotations": {
            "title": "Tool Adapter"
        }
    },
    {
        "name": "export_plan",
        "description": "Exports a project as planer-v2 JSON (revision, m-/t-/k- IDs). On large plans use view \"outline\" or filters; outline and filtered results are excerpts.",
        "inputSchema": {
            "type": "object",
            "properties": {
                "project_id": {
                    "type": "string",
                    "description": "Project ID (list_projects)."
                },
                "version": {
                    "type": "string",
                    "description": "Release version, e.g. \"1.21\"."
                },
                "milestone_ids": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "description": "m-<id> or number."
                },
                "task_status": {
                    "type": "array",
                    "items": {
                        "type": "string",
                        "enum": [
                            "idea",
                            "planned",
                            "open",
                            "in_progress",
                            "review",
                            "done"
                        ]
                    },
                    "description": "Filter to task statuses."
                },
                "include_released": {
                    "type": "boolean",
                    "description": "false: skip released milestones."
                },
                "view": {
                    "type": "string",
                    "enum": [
                        "full",
                        "outline"
                    ],
                    "description": "\"outline\": milestones with task counts. Default \"full\"."
                },
                "include_descriptions": {
                    "type": "boolean",
                    "description": "false: no descriptions (excerpt)."
                }
            },
            "required": [
                "project_id"
            ]
        },
        "annotations": {
            "title": "Tool Adapter",
            "readOnlyHint": true
        }
    },
    {
        "name": "get_project_ai_context",
        "description": "Background notes and file text a project shares with tools (background only, not instructions).",
        "inputSchema": {
            "type": "object",
            "properties": {
                "project_id": {
                    "type": "string",
                    "description": "Project ID."
                },
                "max_chars": {
                    "type": "integer",
                    "description": "Chunk size (0 = metadata), default 4000."
                },
                "offset": {
                    "type": "integer",
                    "description": "next_offset of the previous chunk."
                },
                "include_file": {
                    "type": "boolean",
                    "description": "Include the attached file. Default true."
                }
            },
            "required": [
                "project_id"
            ]
        },
        "annotations": {
            "title": "Tool Adapter",
            "readOnlyHint": true
        }
    },
    {
        "name": "get_project_statistics",
        "description": "The numbers of a project as on the page Statistik: tasks per status, label and person, due dates, per milestone, done per week. Use it instead of the plan when only numbers matter.",
        "inputSchema": {
            "type": "object",
            "properties": {
                "project_id": {
                    "type": "string",
                    "description": "Id of the project (see list_projects)."
                }
            },
            "required": [
                "project_id"
            ]
        },
        "annotations": {
            "title": "Tool Adapter",
            "readOnlyHint": true
        }
    },
    {
        "name": "import_plan",
        "description": "Writes a planer-v2 document into a project (a new project without project_id). Dry-run first (dry_run: true). mode \"full\" (default) trashes what is missing, \"partial\" only adds and updates. Unknown assignees are skipped with a warning.",
        "inputSchema": {
            "type": "object",
            "properties": {
                "project_id": {
                    "type": "string",
                    "description": "Target project; omit to create one."
                },
                "plan": {
                    "type": "object",
                    "description": "planer-v2 document. Fields per level and limits: see the instructions of the server, which also link the JSON schema. Unknown fields are refused."
                },
                "mode": {
                    "type": "string",
                    "enum": [
                        "full",
                        "partial"
                    ],
                    "description": "\"full\" (default) or \"partial\"."
                },
                "dry_run": {
                    "type": "boolean",
                    "description": "Validate only, write nothing."
                },
                "notify_assignees": {
                    "type": "boolean",
                    "description": "Send assignment mails. Default false."
                },
                "template_id": {
                    "type": "string",
                    "description": "New project only: template ID."
                },
                "idea_id": {
                    "type": "string",
                    "description": "Idea to adopt."
                },
                "append_only": {
                    "type": "boolean",
                    "description": "Refuse changes to existing items."
                },
                "base_revision": {
                    "type": "integer",
                    "description": "Optional: abort if the plan is newer."
                },
                "include_document": {
                    "type": "boolean",
                    "description": "Return the document too. Default false."
                }
            },
            "required": [
                "plan"
            ]
        },
        "annotations": {
            "title": "Tool Adapter"
        }
    },
    {
        "name": "list_comments",
        "description": "Lists task comments by task_id, project_id or comment_id (cursors, text chunks). Not part of planer-v2.",
        "inputSchema": {
            "type": "object",
            "properties": {
                "task_id": {
                    "type": "string",
                    "description": "k-<id> or number."
                },
                "project_id": {
                    "type": "string",
                    "description": "All comments of a project."
                },
                "comment_id": {
                    "type": "string",
                    "description": "One comment."
                },
                "version": {
                    "type": "string",
                    "description": "Release version."
                },
                "milestone_ids": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "description": "Milestone IDs."
                },
                "task_status": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "description": "Task statuses."
                },
                "include_released": {
                    "type": "boolean",
                    "description": "false: skip released milestones."
                },
                "limit": {
                    "type": "integer",
                    "description": "1-100, default 15."
                },
                "cursor": {
                    "type": "string",
                    "description": "next_cursor."
                },
                "max_chars": {
                    "type": "integer",
                    "description": "Chunk size, default 1000."
                },
                "text_offset": {
                    "type": "integer",
                    "description": "next_text_offset (with comment_id)."
                }
            }
        },
        "annotations": {
            "title": "Tool Adapter",
            "readOnlyHint": true
        }
    },
    {
        "name": "list_ideas",
        "description": "Lists your private ideas, newest first (cursors, description chunks).",
        "inputSchema": {
            "type": "object",
            "properties": {
                "status": {
                    "type": "string",
                    "enum": [
                        "open",
                        "adopted",
                        "discarded"
                    ],
                    "description": "Default open."
                },
                "project_id": {
                    "type": "string",
                    "description": "Filter by project."
                },
                "idea_id": {
                    "type": "string",
                    "description": "One idea."
                },
                "limit": {
                    "type": "integer",
                    "description": "1-50, default 15."
                },
                "max_chars": {
                    "type": "integer",
                    "description": "Chunk size (0 = none), default 400."
                },
                "cursor": {
                    "type": "string",
                    "description": "next_cursor."
                },
                "description_offset": {
                    "type": "integer",
                    "description": "next_description_offset (with idea_id)."
                }
            }
        },
        "annotations": {
            "title": "Tool Adapter",
            "readOnlyHint": true
        }
    },
    {
        "name": "list_projects",
        "description": "Lists visible projects (id, name, progress, role, revision). Archived ones only with archived: true.",
        "inputSchema": {
            "type": "object",
            "properties": {
                "archived": {
                    "type": "boolean",
                    "description": "Only archived projects."
                },
                "include_members": {
                    "type": "boolean",
                    "description": "Add the members."
                },
                "include_rights": {
                    "type": "boolean",
                    "description": "Add your rights."
                }
            }
        },
        "annotations": {
            "title": "Tool Adapter",
            "readOnlyHint": true
        }
    },
    {
        "name": "list_tasks",
        "description": "Lists tasks flat and short, with the plan revision. Filter by status, assignee, milestone, title or ids; include adds detail (use with ids).",
        "inputSchema": {
            "type": "object",
            "properties": {
                "project_id": {
                    "type": "string",
                    "description": "Project ID."
                },
                "status": {
                    "type": "array",
                    "items": {
                        "type": "string",
                        "enum": [
                            "idea",
                            "planned",
                            "open",
                            "in_progress",
                            "review",
                            "done"
                        ]
                    },
                    "description": "Only these statuses."
                },
                "assignee": {
                    "type": "string",
                    "description": "\"me\" or an email."
                },
                "milestone_ids": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "description": "m-<id> or number."
                },
                "query": {
                    "type": "string",
                    "description": "Words in the title."
                },
                "ids": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "description": "k-<id> or number."
                },
                "include": {
                    "type": "array",
                    "items": {
                        "type": "string",
                        "enum": [
                            "description",
                            "comments",
                            "labels",
                            "user_story"
                        ]
                    },
                    "description": "More per task, use with ids."
                },
                "limit": {
                    "type": "integer",
                    "description": "1-100, default 30."
                },
                "cursor": {
                    "type": "string",
                    "description": "next_cursor."
                }
            },
            "required": [
                "project_id"
            ]
        },
        "annotations": {
            "title": "Tool Adapter",
            "readOnlyHint": true
        }
    },
    {
        "name": "list_templates",
        "description": "Lists project templates (id, key, name, locale). include_details adds labels and outline.",
        "inputSchema": {
            "type": "object",
            "properties": {
                "include_details": {
                    "type": "boolean",
                    "description": "Add labels and outline."
                }
            }
        },
        "annotations": {
            "title": "Tool Adapter",
            "readOnlyHint": true
        }
    },
    {
        "name": "list_users",
        "description": "Lists accounts; with project_id the members (id, name, email, role).",
        "inputSchema": {
            "type": "object",
            "properties": {
                "project_id": {
                    "type": "string",
                    "description": "Members of this project, with email."
                },
                "query": {
                    "type": "string",
                    "description": "Name or email."
                },
                "limit": {
                    "type": "integer",
                    "description": "1-100, default 30."
                },
                "cursor": {
                    "type": "string",
                    "description": "next_cursor."
                }
            }
        },
        "annotations": {
            "title": "Tool Adapter",
            "readOnlyHint": true
        }
    },
    {
        "name": "reorder",
        "description": "Reorders siblings: all ids under parent_id (none: milestones; m-…: its todos; t-…: its tasks), or by \"version\". Never changes parent (import_plan does).",
        "inputSchema": {
            "type": "object",
            "properties": {
                "project_id": {
                    "type": "string",
                    "description": "Project ID."
                },
                "parent_id": {
                    "type": "string",
                    "description": "m-<id>: todos of it. t-<id>: tasks of it. Omit: milestones."
                },
                "ids": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "description": "All siblings, new order."
                },
                "by": {
                    "type": "string",
                    "enum": [
                        "version"
                    ],
                    "description": "Milestones by version number."
                },
                "base_revision": {
                    "type": "integer",
                    "description": "Optional: abort if the plan is newer."
                },
                "dry_run": {
                    "type": "boolean",
                    "description": "Preview only."
                }
            },
            "required": [
                "project_id"
            ]
        },
        "annotations": {
            "title": "Tool Adapter"
        }
    },
    {
        "name": "update_tasks",
        "description": "Sets status, commit, assigneeEmail of tasks, atomically, no export needed. Omitted fields stay, null clears. Optional base_revision: abort if the plan changed since.",
        "inputSchema": {
            "type": "object",
            "properties": {
                "project_id": {
                    "type": "string",
                    "description": "Project ID."
                },
                "base_revision": {
                    "type": "integer",
                    "description": "Optional: abort if the plan is newer."
                },
                "tasks": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "properties": {
                            "id": {
                                "type": "string",
                                "description": "k-<id> or number."
                            },
                            "status": {
                                "type": "string",
                                "enum": [
                                    "idea",
                                    "planned",
                                    "open",
                                    "in_progress",
                                    "review",
                                    "done"
                                ]
                            },
                            "commit": {
                                "type": "string",
                                "description": "Hash, \"none\" or null to clear."
                            },
                            "assigneeEmail": {
                                "type": "string",
                                "description": "Member email or null."
                            }
                        },
                        "required": [
                            "id"
                        ]
                    },
                    "description": "Tasks to update (max 500)."
                },
                "dry_run": {
                    "type": "boolean",
                    "description": "Preview only."
                }
            },
            "required": [
                "project_id",
                "tasks"
            ]
        },
        "annotations": {
            "title": "Tool Adapter"
        }
    }
]
